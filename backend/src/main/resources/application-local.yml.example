# 복사해서 application-local.yml로 사용 (Git에 올라가지 않음)
#   cp application-local.yml.example application-local.yml
# DB 값은 docker-compose.yml과 같다. 키는 팀 비공개 메모에서 받아 채운다.
spring:
  datasource:
    driver-class-name: org.mariadb.jdbc.Driver
    url: jdbc:mariadb://localhost:3306/transportdb   # 포트를 3307로 바꿨다면 여기도 3307
    username: transport
    password: transport1234
  jpa:
    hibernate:
      ddl-auto: update            # 개발 중에만. 배포(prod)는 validate
    show-sql: true
    defer-datasource-initialization: true   # 테이블을 만든 뒤 data.sql 실행
  sql:
    init:
      mode: never                 # data.sql에 나오는 엔티티가 모두 생기면 always로 바꾼다

app:
  upload-path: upload
  cors:
    allowed-origins: http://localhost:5173
  jwt:
    secret: change-me-to-a-long-random-string-at-least-32-characters
    access-minutes: 30
    refresh-minutes: 1440
  kakao:
    rest-api-key:                 # 카카오 팀 앱 REST API 키 (서버 전용)
  toss:
    secret-key:                   # 토스 테스트 시크릿 키 (서버 전용, 절대 프론트에 넣지 않기)
