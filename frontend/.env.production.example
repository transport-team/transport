# 운영 빌드용 — 복사해서 .env.production.local로 사용 (cp .env.production.example .env.production.local)
# .env.production.local은 Git에 올라가지 않는다. 배포 스크립트(deploy/deploy.sh)가 이 파일로 빌드한다

# 비워 둔다: 프론트와 API가 같은 주소라 /api/...를 그대로 부른다 (Nginx가 백엔드로 넘김)
VITE_API_HOST=

# 카카오 디벨로퍼스 팀 앱의 JavaScript 키 (배포 도메인을 카카오 앱 플랫폼에 등록해야 동작)
VITE_KAKAO_JS_KEY=

# 토스페이먼츠 클라이언트 키 (테스트 키)
VITE_TOSS_CLIENT_KEY=
